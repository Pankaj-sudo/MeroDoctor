rules_version = '2';

// ============================================================================
// MeroDoctor — Firestore Security Rules
//   users            — one doc per account; role lives here (source of truth)
//   consultations    — the patient intake + doctor-managed lifecycle
//   activity_logs    — immutable audit trail of doctor actions
// Trust model: patients own their records; doctors/admin/clinic_staff manage
// consultations. Roles are read from /users/{uid}.role — never client input.
// ============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function role() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'anonymous';
    }
    // The practice's registered physician email(s), who are also administrators.
    // A self-signup may claim the 'doctor' role ONLY when the Firebase-verified
    // token email is on this list, so the Doctor/Admin Dashboard can never be
    // reached by spoofing a role client-side. Add emails here to onboard doctors.
    function doctorEmails() { return ['pankaj.ydv707@gmail.com']; }
    function isDoctorEmail() {
      return request.auth != null && request.auth.token.email != null
        && request.auth.token.email.lower() in doctorEmails();
    }

    function isStaff() { return role() in ['doctor', 'admin', 'clinic_staff'] || isDoctorEmail(); }
    // Administrators: the 'admin' role, or a registered physician email (which is
    // granted full admin privileges by design).
    function isAdmin() { return role() == 'admin' || isDoctorEmail(); }

    // ------------------------------------------------------------------ users
    match /users/{uid} {
      allow read: if isOwner(uid) || isStaff();
      // Self-signup may create a patient; the 'doctor' role is allowed only for a
      // registered physician email (verified by the auth token, not client input).
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && (request.resource.data.role == 'patient'
            || (request.resource.data.role == 'doctor' && isDoctorEmail()));
      // Owners may refresh their profile but not change their own role — except a
      // registered physician email may (self-)promote to 'doctor'. Admins may anything.
      allow update: if isAdmin()
        || (isOwner(uid)
            && request.resource.data.uid == resource.data.uid
            && (request.resource.data.role == resource.data.role
                || (request.resource.data.role == 'doctor' && isDoctorEmail())));
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------- consultations
    match /consultations/{id} {
      allow read: if isOwner(resource.data.patientId) || isStaff();

      // a patient creates their own consultation, starting at payment_pending
      allow create: if isSignedIn()
        && request.resource.data.patientId == request.auth.uid
        && request.resource.data.status == 'payment_pending';

      // staff drive the whole lifecycle; the patient may ONLY re-touch payment
      // (e.g. re-upload a screenshot) and can never move their own status/clinical.
      allow update: if isStaff()
        || (isOwner(resource.data.patientId)
            && request.resource.data.patientId == resource.data.patientId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payment', 'updatedAt']));

      allow delete: if isAdmin();
    }

    // -------------------------------------------------------- audit / activity
    match /activity_logs/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false; // append-only audit trail
    }

    // ------------------------------------------------------------ videoRooms
    // One document per booking; the document id IS the consultation id, which
    // makes "exactly one room per consultation" a structural guarantee.
    //
    // Writes are SERVER-ONLY. Room creation, join-token minting and teardown
    // all happen in the serverless API using the Admin SDK (which bypasses
    // these rules), because they require the provider's secret API key. Denying
    // all client writes means a patient can never fabricate a room, extend an
    // expiry, or resurrect an ended consultation.
    //
    // Reading is limited to the two participants. Note the room URL is not a
    // credential on its own: rooms are private at the provider and joining
    // requires a server-minted, identity-scoped token.
    match /videoRooms/{consultationId} {
      // `resource == null` covers the NORMAL "no room yet" case: without it, a
      // read of a not-yet-created room evaluates resource.data on null and is
      // denied, so the client would see a permission error instead of an empty
      // result on every unapproved consultation. A missing document carries no
      // data, so permitting it leaks nothing.
      allow read: if isSignedIn()
        && (resource == null
            || request.auth.uid in resource.data.participantIds
            || isStaff());
      allow write: if false; // Admin SDK only — see api/consultations/*
    }

    // -------------------------------------------------- consultationMessages
    // In-consultation chat. `participantIds` is denormalised onto every message
    // so a read can be authorised without a get() on the consultation for each
    // document — that keeps a live chat subscription cheap AND enforceable.
    match /consultationMessages/{id} {
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.participantIds || isStaff());

      // A sender may only ever write as themselves, and only into a thread they
      // belong to. Text is bounded so the collection can't be used as storage.
      allow create: if isSignedIn()
        && request.resource.data.senderId == request.auth.uid
        && (request.auth.uid in request.resource.data.participantIds || isStaff())
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.senderRole in ['patient', 'doctor'];

      // Clinical records are immutable — an edited transcript is worthless.
      allow update, delete: if false;
    }

    // ---------------------------------------------------- consultationEvents
    // Presence + call audit trail (joined/left/connection/ended).
    match /consultationEvents/{id} {
      allow read: if isSignedIn()
        && (request.auth.uid in resource.data.participantIds || isStaff());
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && (request.auth.uid in request.resource.data.participantIds || isStaff());
      allow update, delete: if false; // append-only
    }

    // ----------------------------------- future collections (locked by default)
    match /notifications/{id} { allow read, write: if isStaff(); }
  }
}
