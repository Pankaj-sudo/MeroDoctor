# ============================================================================
# CLIENT (browser) — must be prefixed VITE_ to be exposed to the app.
# ============================================================================
# Firebase web config — Project settings → Your apps → Web app.
# These identify the project; they are NOT secrets (access is gated by Firebase
# Auth + Firestore Security Rules). Copy to `.env.local` and fill in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================================
# SERVER (Vercel serverless functions only) — NEVER prefix these with VITE_.
# A VITE_ prefix would inline them into the browser bundle and leak them.
# Set these in Vercel → Project → Settings → Environment Variables.
# ============================================================================

# --- Video provider -------------------------------------------------------
# Daily.co API key: dashboard.daily.co → Developers → API keys.
# This is a SECRET. It creates rooms and mints join tokens; anyone holding it
# can create rooms on your account.
DAILY_API_KEY=

# Which provider new rooms use. Defaults to `daily`. Rooms remember the
# provider that created them, so changing this is safe for in-flight calls.
# VIDEO_PROVIDER=daily

# --- Firebase Admin (service account) -------------------------------------
# Firebase console → Project settings → Service accounts → Generate new private
# key. The API uses this to verify ID tokens and to write videoRooms documents
# (which client security rules deny outright).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the full PEM including the BEGIN/END lines. Newlines must be escaped as
# \n (Vercel stores it single-line); the server converts them back.
FIREBASE_PRIVATE_KEY=
